---
import { SITE } from '~/lib/site';

const year = new Date().getFullYear();

const columns: Array<{ title: string; links: Array<{ href: string; label: string }> }> = [
  {
    title: 'Produto',
    links: [
      { href: '/como-funciona/', label: 'Como funciona' },
      { href: '/baixar/', label: 'Baixar app' },
      { href: '/para-guias/', label: 'Sou guia de pesca' },
    ],
  },
  {
    title: 'Empresa',
    links: [
      { href: '/contato/', label: 'Contato' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/termos/', label: 'Termos de Uso' },
      { href: '/privacidade/', label: 'Política de Privacidade' },
      { href: '/excluir-conta/', label: 'Excluir minha conta' },
    ],
  },
];
---
<footer class="border-t border-surface-border bg-white">
  <div class="container-page py-12">
    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <a href="/" class="inline-flex items-center gap-2" aria-label={`${SITE.name}, voltar à página inicial`}>
          <img src="/ifishing-icon.png" alt="" height="40" width="40" class="h-10 w-10 rounded-lg" />
          <span class="font-display text-xl font-extrabold tracking-tight text-ink">iFishing</span>
        </a>
        <p class="mt-3 text-sm text-ink-muted max-w-xs">
          O app que conecta pescadores a guias de pesca profissionais em todo o Brasil.
        </p>
        <div class="mt-4 flex items-center gap-4">
          {SITE.social.instagram && (
            <a href={SITE.social.instagram} target="_blank" rel="me noopener" class="text-ink-muted hover:text-brand-dark" aria-label="Instagram do iFishing">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          )}
          {SITE.social.facebook && (
            <a href={SITE.social.facebook} target="_blank" rel="me noopener" class="text-ink-muted hover:text-brand-dark" aria-label="Facebook do iFishing">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          )}
          {SITE.social.tiktok && (
            <a href={SITE.social.tiktok} target="_blank" rel="me noopener" class="text-ink-muted hover:text-brand-dark" aria-label="TikTok do iFishing">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
            </a>
          )}
        </div>
      </div>
      {columns.map((col) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-muted">{col.title}</h3>
          <ul class="mt-4 space-y-2">
            {col.links.map((link) => (
              <li><a href={link.href} class="text-sm text-ink hover:text-brand-dark">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-12 border-t border-surface-border pt-6 flex flex-col gap-2 md:flex-row md:items-center md:justify-between text-sm text-ink-muted">
      <p>
        © {year} {SITE.legal.razaoSocial}, CNPJ {SITE.legal.cnpj}
      </p>
      <p>
        Contato: <a class="hover:text-brand-dark" href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>
      </p>
    </div>
  </div>
</footer>
